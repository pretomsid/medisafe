{
  "functions": {
    "api/index.py": {
      "includeFiles": "api/**,backend/**,model1/models/**,model2/models/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    }
  ]
}
