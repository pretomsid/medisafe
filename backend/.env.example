# কপি করে .env বানান। কোড না বদলে শুধু এখান থেকে সেটিং বদলানো যায়।
SECRET_KEY=change-me
# ডিফল্ট: SQLite (কিছু install লাগে না)
DATABASE_URL=sqlite:///medisafe.db
# MySQL-এর জন্য:
# DATABASE_URL=mysql+pymysql://user:password@localhost/medisafe

# Prescription reading (optional). With no key, photos are read free in the browser (Tesseract.js).
# Free Gemini key (aistudio.google.com/apikey) or a paid Claude key give better handwriting/PDF reading:
# GEMINI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
